<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs estruturados (JSON) com logstash-logback-encoder.

  - Console: sempre JSON (o `docker compose logs api` mostra o mesmo formato que chega ao ELK).
  - Logstash (TCP 50000): ativo apenas no profile `demo`, usado pelo docker-compose.
    O appender é assíncrono e reconecta sozinho; se o Logstash cair, a API continua atendendo.

  Campos fixos: service e environment. Campos por requisição vêm do MDC (trace_id, http.*,
  order_id) e de StructuredArguments (valores numéricos como http.status e http.duration_ms).
-->
<configuration>
    <springProperty scope="context" name="SERVICE_NAME" source="spring.application.name" defaultValue="ezbikes-api"/>
    <springProperty scope="context" name="ENVIRONMENT" source="ezbikes.environment" defaultValue="local"/>
    <springProperty scope="context" name="LOGSTASH_DESTINATION" source="ezbikes.logging.logstash-destination" defaultValue="logstash:50000"/>

    <property name="CUSTOM_FIELDS" value='{"service":"${SERVICE_NAME}","environment":"${ENVIRONMENT}"}'/>

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>false</includeContext>
            <customFields>${CUSTOM_FIELDS}</customFields>
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <message>message</message>
                <level>level</level>
                <logger>logger</logger>
                <thread>thread</thread>
                <levelValue>[ignore]</levelValue>
                <version>[ignore]</version>
            </fieldNames>
        </encoder>
    </appender>

    <springProfile name="demo">
        <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${LOGSTASH_DESTINATION}</destination>
            <reconnectionDelay>5 seconds</reconnectionDelay>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeContext>false</includeContext>
                <customFields>${CUSTOM_FIELDS}</customFields>
                <fieldNames>
                    <timestamp>@timestamp</timestamp>
                    <message>message</message>
                    <level>level</level>
                    <logger>logger</logger>
                    <thread>thread</thread>
                    <levelValue>[ignore]</levelValue>
                    <version>[ignore]</version>
                </fieldNames>
            </encoder>
        </appender>
    </springProfile>

    <logger name="br.com.ezbikes" level="INFO"/>

    <!-- <springProfile> não pode ficar dentro de <root>; por isso há um <root> por cenário. -->
    <springProfile name="demo">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="LOGSTASH"/>
        </root>
    </springProfile>
    <springProfile name="!demo">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>
</configuration>
