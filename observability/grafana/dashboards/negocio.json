      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(ezbikes_orders_total{status=\"paid\"}[$__rate_interval])) * 60",
          "legendFormat": "pago",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(ezbikes_orders_total{status=\"payment_failed\"}[$__rate_interval])) * 60",
          "legendFormat": "falha no pagamento",
          "refId": "B",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(ezbikes_orders_total{status=\"out_of_stock\"}[$__rate_interval])) * 60",
          "legendFormat": "sem estoque",
          "refId": "C",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(ezbikes_orders_total{status=~\"rejected|error\"}[$__rate_interval])) * 60",
          "legendFormat": "rejeitado / erro",
          "refId": "D",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "barAlignment": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
