# Copie para .env e ajuste se necessário (o .env não vai para o git)
POSTGRES_DB=ezbikes
POSTGRES_USER=ezbikes
POSTGRES_PASSWORD=ezbikes

# Grafana (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ezbikes

# Probabilidade inicial de falha do gateway de pagamento simulado (0 a 1)
EZBIKES_PAYMENT_FAILURE_RATE=0.0

# Token da API administrativa /admin/** (caos e estoque). Mínimo de 12 caracteres.
EZBIKES_ADMIN_TOKEN=demo-admin-token-troque
